# Intestazioni di sicurezza che Cloudflare aggiunge a ogni pagina del Dojo.
# Il browser carica script, stili e font solo dal sito stesso, il CAPTCHA solo da Cloudflare
# (il gioco della Prova è WebAssembly: 'wasm-unsafe-eval' permette solo quello, non eval di testo)
# e le statistiche anonime solo da Cloudflare Web Analytics, e parla solo con Supabase e Cloudflare: un eventuale codice iniettato non può spedire dati altrove.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://cloudflareinsights.com https://cwlrmzwfkvjhejupirzw.supabase.co wss://cwlrmzwfkvjhejupirzw.supabase.co; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
